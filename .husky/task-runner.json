{
  "tasks": [
      {
         "name": "commit-message-linter",
         "command": "dotnet",
         "args": [ "husky", "exec", ".husky/csx/commit-lint.csx", "--args", "${args}" ]
      },
      {
         "name": "secret-scan",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "husky", "exec", ".husky/csx/secret-scan.csx", "--args", "${staged}" ],
         "include": [ "**/*" ],
         "output": "always"
      }
  ]
}